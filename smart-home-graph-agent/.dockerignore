# =========================================
# Docker Build Exclusions
# =========================================
# These files are NOT copied into the Docker image.
#
# Teaching Point:
#   .dockerignore works like .gitignore for docker build.
#   Excluding unnecessary files makes builds faster and images smaller.

# Virtual environment (dependencies are installed in the Docker image)
.venv/
venv/
__pycache__/
*.pyc

# Environment files (secrets should not be baked into images!)
.env
.env.local

# Version control
.git/
.gitignore

# IDE / Editor
.claude/
.vscode/
.idea/
*.swp
*.swo

# Notebooks (not needed for API/Streamlit runtime)
notebooks/

# Documentation (not needed at runtime)
docs/

# OS files
.DS_Store
Thumbs.db

# Docker files (avoid recursive build context)
Dockerfile
docker-compose.yml
.dockerignore
